{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thai-ho.github.io/agent-skills/schemas/frame.schema.json",
  "type": "object",
  "required": ["rootId", "dimensions", "nodes", "dependencies", "evidence"],
  "properties": {
    "rootId": { "$ref": "common.schema.json#/$defs/id" },
    "dimensions": { "type": "object", "required": ["width", "height"], "properties": {
      "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }
    }, "additionalProperties": false },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "evidence": { "$ref": "common.schema.json#/$defs/evidence" }
  }, "additionalProperties": false,
  "$defs": {
    "node": { "type": "object", "required": ["id", "type", "name", "evidence"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" }, "type": { "type": "string" }, "name": { "type": "string" },
        "layout": { "type": "object" }, "typography": { "type": "object" }, "fills": { "type": "array" },
        "strokes": { "type": "array" }, "effects": { "type": "array" }, "constraints": { "type": "object" },
        "componentId": { "$ref": "common.schema.json#/$defs/id" },
        "tokenIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
        "assetPaths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/path" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "evidence": { "$ref": "common.schema.json#/$defs/evidence" }
      }, "additionalProperties": false }
  }
}
