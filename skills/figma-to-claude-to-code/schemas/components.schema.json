{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thai-ho.github.io/agent-skills/schemas/components.schema.json",
  "type": "object", "required": ["components", "capability"],
  "properties": {
    "capability": { "enum": ["available", "unavailable", "not-applicable"] },
    "components": { "type": "array", "items": { "type": "object", "required": ["id", "name", "evidence"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" }, "name": { "type": "string" },
        "key": { "type": "string" }, "properties": { "type": "object" }, "variants": { "type": "array" },
        "mapping": { "type": "object", "required": ["status"], "properties": {
          "status": { "enum": ["verified", "unverified", "missing"] },
          "importPath": { "type": "string" }, "usage": { "type": "string" },
          "evidence": { "$ref": "common.schema.json#/$defs/evidence" }
        }, "additionalProperties": false },
        "evidence": { "$ref": "common.schema.json#/$defs/evidence" }
      }, "additionalProperties": false }
    }
  }, "additionalProperties": false
}
